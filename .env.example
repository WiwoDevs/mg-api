# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
#
# Generar MGAPI_KEY y HMAC_SECRETO:   openssl rand -base64 48
# Generar COLA_CLAVE_CIFRADO:         openssl rand -base64 32

NODE_ENV=production
HOST=127.0.0.1
PUERTO=3000

# --- Perimetro ---
DOMINIO=api.ejemplo.cl
# IP de salida de GHL, separadas por espacios. Acepta bloques CIDR: 1.2.3.0/24
# La leen Caddy y la aplicacion. Vacia = sin filtro de IP, solo protege la clave.
IPS_GHL=
# Desde donde se acepta la cabecera X-Forwarded-For. NUNCA poner 'true':
# eso deja que el cliente declare su propia IP y burle el limite de tasa.
PROXY_CONFIABLE=uniquelocal
# Claves incorrectas seguidas antes de bloquear una IP, y cuanto dura el bloqueo.
AUTH_FALLOS_MAX=10
AUTH_BLOQUEO_MINUTOS=15

# --- Identidad del llamante (GHL) ---
# Clave que GHL envia en la cabecera X-Mgapi-Key. Minimo 32 caracteres.
MGAPI_KEY=
# Firma HMAC del cuerpo. Dejar en false hasta confirmar que GHL puede firmar.
HMAC_ACTIVO=false
HMAC_SECRETO=
HMAC_VENTANA_SEGUNDOS=300

# --- API externa (Zoho) ---
# En false no se llama a Zoho: el reclamo se valida y se responde en modo
# simulado, y las credenciales de abajo quedan opcionales.
UPSTREAM_ACTIVO=false
# Endpoint de la funcion de Zoho CRM que recibe el reclamo.
UPSTREAM_URL=https://www.zohoapis.com/crm/v7/functions/zohodeskcasewebsiteapi/actions/execute

# Credenciales OAuth. Se sacan de api-console.zoho.com y viven SOLO aqui:
# GoHighLevel no debe tenerlas. El refresh token no expira: tratarlo como una
# contrasena y rotarlo ante cualquier sospecha.
# El dominio cambia segun el centro de datos: .com, .eu, .in, .com.au
ZOHO_CUENTAS_URL=https://accounts.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_MARGEN_SEGUNDOS=60
# Nombre del argumento con el que la funcion de Zoho recibe el caso.
ZOHO_ARGUMENTO_CASO=case
# Espera antes de llamar a la funcion. En cero porque aqui no hace falta:
# el flujo anterior en GHL la necesitaba por como encadenaba sus pasos.
ZOHO_ESPERA_MS=0
UPSTREAM_TIMEOUT_MS=10000
UPSTREAM_PRESUPUESTO_DIARIO=1000

# --- Cola de reintentos ---
COLA_ARCHIVO=./datos/cola.sqlite
# Exactamente 32 bytes en base64. Rotarla invalida lo que ya este en cola.
COLA_CLAVE_CIFRADO=
COLA_INTENTOS_MAX=6
COLA_INTERVALO_MS=15000
COLA_RETENCION_MUERTOS_DIAS=7

# --- Limites de abuso ---
LIMITE_POR_MINUTO=60

# --- Modo captura (temporal) ---
# Abre POST /v1/captura SIN CLAVE para descubrir que manda GHL. Devuelve todo lo
# que recibe. Se apaga solo tras CAPTURA_MAXIMA peticiones. Ver docs/05-modo-captura.md
MODO_CAPTURA=false
CAPTURA_MAXIMA=50
